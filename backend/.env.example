# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string, e.g. postgres://<user>:<password>@localhost:5432/<database>
DATABASE_URL=
# Set to true for hosted databases that require TLS on external connections
DATABASE_SSL=false

# Optional: a SEPARATE, disposable database for integration tests (all tables are truncated)
TEST_DATABASE_URL=

# Google Gemini API key (https://aistudio.google.com/apikey). Required for AI extraction;
# without it the API still runs and extraction runs fail with AI_NOT_CONFIGURED.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Per-request timeout for the model call, in milliseconds
AI_TIMEOUT_MS=120000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins (only needed when the frontend is on another origin)
CORS_ORIGIN=http://localhost:5173

# Optional: serve the built frontend from this API (single-service deployment), relative to backend/
# FRONTEND_DIST_DIR=../frontend/dist
