{
  "name": "contract-obligation-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Contract Obligation Assistant (information-management tool, not legal advice)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js latest",
    "migrate:rollback": "node src/db/migrate.js rollback",
    "migrate:status": "node src/db/migrate.js status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "docx": "^9.8.1",
    "pdfkit": "^0.20.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
